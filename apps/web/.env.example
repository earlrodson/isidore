# Postgres connection string used by apps/web and packages/db (drizzle.config.ts).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/isidore

# GitHub App used for onboarding login (docs/features/onboarding-oauth.md).
# Client id/secret come from the App's "General" settings page; slug is the
# App's URL slug, used to build https://github.com/apps/<slug>/installations/new.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# owner/repo isidore-worker's GitHub Release tarballs are published from
# (docs/features/onboarding-oauth.md AC-006). Defaults to earlrodson/isidore
# in apps/web/src/lib/ci-snippet.ts if unset.
ISIDORE_SOURCE_REPO=
