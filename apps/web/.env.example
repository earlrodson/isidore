# Postgres connection string used by apps/web and packages/db (drizzle.config.ts).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/isidore

# GitHub App used for onboarding login (docs/features/onboarding-oauth.md).
# Client id/secret come from the App's "General" settings page; slug is the
# App's URL slug, used to build https://github.com/apps/<slug>/installations/new.
GITHUB_APP_CLIENT_ID=Iv23liBIdgDu2UYcOQyb
GITHUB_APP_CLIENT_SECRET=87a6be37dcc0e905fc07d7dd52dabe37187acbf1
GITHUB_APP_SLUG=isidore-x

# owner/repo isidore-worker's GitHub Release tarballs are published from
# (docs/features/onboarding-oauth.md AC-006). Defaults to earlrodson/isidore
# in apps/web/src/lib/ci-snippet.ts if unset.
ISIDORE_SOURCE_REPO=

# SMTP used to send viewer magic-link sign-in emails
# (docs/specifications/viewer-magic-link-access.md AC-013).
# Uses Gmail's SMTP relay (free, no Vercel Marketplace integration needed):
#   1. Enable 2-Step Verification on the Gmail/Workspace account (SMTP_USER)
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#      — that 16-char password is SMTP_PASS
#   3. SMTP_FROM must be SMTP_USER's own address, or a verified "Send As"
#      alias under Gmail Settings > Accounts > Send mail as — Gmail
#      rejects/rewrites a From it doesn't recognize
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Isidore <noreply@example.com>"

# Comma-separated emails allowed to reach /admin/access and manage which
# emails can view which projects (viewer-magic-link-access.md AC-010).
ISIDORE_ADMIN_EMAILS=
