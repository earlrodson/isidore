{
  "name": "@isidore/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "isidore-worker-ci": "./dist/ci-entry.js",
    "isi": "./dist/cli.js"
  },
  "files": ["dist", "resources"],
